{
  "info": {
    "name": "CollegeManagementAPI",
    "_postman_id": "college-management-api",
    "description": "A minimal Postman collection for the College Management REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Students",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/students",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","students"]
        }
      }
    },
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"12345\",\n  \"departmentId\": \"dept1\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/students",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","students"]
        }
      }
    },
    {
      "name": "Get Student",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/students/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","students",":id"],
          "variable": [{"key":"id","value":""}]
        }
      }
    }
  ]
}
